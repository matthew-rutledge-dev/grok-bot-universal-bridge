{
  "readOnlyRef": "env:GROKBUILD_READ_ONLY",
  "callbackTokenRef": "env:GROKBUILD_CALLBACK_TOKEN",
  "maxPromptChars": 8000,
  "replyTtlSec": 3600,
  "promptsPerMin": 20,
  "readsPerMin": 240,
  "maxOpenRequests": 200,
  "replyTokenTtlSec": 21600,
  "replyAuthFailsPerMin": 60,
  "replyAttemptsPerRequest": 10,
  "maxWaitSec": 25,
  "maxLongPolls": 32,
  "tombstoneSec": 3600,
  "repliedKeepSec": 3600,
  "readKeepSec": 600,
  "clients": {
    "example-client": {
      "tokenRef": "env:GROKBUILD_CLIENT_TOKEN"
    }
  },
  "routes": [
    {
      "id": "example-client-to-agent",
      "enabled": true,
      "match": {
        "client": "example-client",
        "bot": "example-agent"
      },
      "allowActors": [
        "example-client"
      ],
      "agent": "example-agent"
    }
  ]
}
