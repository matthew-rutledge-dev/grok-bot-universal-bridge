# Example only. On the deployment host this file is rendered from the host's
# vault by a loader script, owned by the service user, mode 600, never in git.
# After changing it: docker compose up -d --force-recreate (a plain restart keeps old env).

BRIDGE_CONFIG=./config/bridge.json

# Registry secrets (names are whatever registry.json references)
EXAMPLE_AGENT_WEBHOOK_URL=https://example.com/automations/webhook/11111111
EXAMPLE_AGENT_WEBHOOK_KEY=changeme
EXAMPLE_GATEWAY_TOKEN=changeme

# Wake-on-sleep hook (optional; blank = off)
BRIDGE_WAKE_URL=
BRIDGE_WAKE_KEY=

# discord adapter
DISCORD_BOT_TOKEN=changeme
DISCORD_CALLBACK_TOKEN=changeme
# local-planner hop (routes with handler "local-planner"); blank = "Couldn't start that."
DISCORD_PLANNER_URL=http://127.0.0.1:18100/plan
DISCORD_PLANNER_TOKEN=changeme
# voice (only when discord.voice.enabled); Piper speaks the Wyoming protocol
PIPER_HOST=127.0.0.1
PIPER_PORT=10200
GROK_VOICE_API_KEY=

# grokbuild adapter
GROKBUILD_CLIENT_TOKEN=changeme
GROKBUILD_CALLBACK_TOKEN=changeme
# Read-only fails closed: unset/empty/1 = prompts refused. Set 0 only after the live check passes (docs/GROKBUILD-CUTOVER.md).
GROKBUILD_READ_ONLY=1

# tesla adapter (skeleton)
TESLA_ENERGY_TOKEN=changeme

# twitch adapter (EventSub webhook; 10-100 chars, the same secret you pass when creating the subscription)
TWITCH_EVENTSUB_SECRET=changeme
