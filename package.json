{
  "name": "grok-bot-universal-bridge",
  "version": "0.2.2",
  "private": true,
  "description": "Generic, deny-by-default bridge from many sources (chat, CLI, vehicle telemetry, ...) to Grok Bots through pluggable source adapters and a private, read-only registry",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "node scripts/run-tests.mjs",
    "check:config": "tsx src/main.ts --check",
    "leak-check": "node scripts/leak-check.mjs",
    "smoke": "tsx scripts/smoke-e2e.ts",
    "live-check:grokbuild": "node scripts/grokbuild-live-check.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "^14.16.3",
    "mqtt": "^5.16.1",
    "opusscript": "0.0.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "node-forge": "^1.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
